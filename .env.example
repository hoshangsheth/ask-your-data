# Copy to .env and fill in. Never commit .env.

# ---- AI provider: gemini | anthropic | openai -------------------------------------------
LLM_PROVIDER=gemini
# Only the key for the provider above is needed.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Leave empty to use the provider's defaults:
#   gemini    -> SQL: gemini-3.8-flash      summary: gemini-3.5-flash-lite
#   anthropic -> SQL: claude-opus-5-5       summary: claude-opus-5-5
#   openai    -> no default: set both
LLM_SQL_MODEL=
LLM_SUMMARY_MODEL=
# low | medium | high  (mapped to Gemini thinking level / Claude effort / OpenAI reasoning effort)
LLM_SQL_REASONING=low
LLM_SUMMARY_REASONING=low

# ---- Database ------------------------------------------------------------------------------
# Local default: SQLite file, auto-seeded on first start.
DATABASE_URL=sqlite:///./data/shop.db
# With Postgres (docker compose sets these for you):
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/shop
# READONLY_DATABASE_URL=postgresql+psycopg://app_readonly:readonly@localhost:5432/shop
# On Vercel, connecting Neon sets DATABASE_URL (postgres://... is accepted as is).

# ---- Uploads --------------------------------------------------------------------------------
MAX_UPLOAD_MB=50
# Files go to Vercel Blob when this is set (Vercel adds it when a Blob store is connected).
# BLOB_READ_WRITE_TOKEN=

MAX_ROWS=500
MAX_ATTEMPTS=3
QUERY_TIMEOUT_MS=5000

# ---- Protect the paid endpoint when deployed publicly ---------------------------------------
APP_API_KEY=
# Question limits, shared by all instances (0 disables one). Days are India time.
QUESTIONS_PER_MINUTE=10
QUESTIONS_PER_DAY_USER=35
QUESTIONS_PER_DAY_GUEST=5
QUESTIONS_PER_DAY_SITE=250
UPLOAD_REQUESTS_PER_MINUTE=120
LOGIN_ATTEMPTS_PER_MINUTE=10

# ---- Accounts --------------------------------------------------------------------------------
# Cookie-signing key; leave empty to have one generated and stored in the database.
SESSION_SECRET=
# Emails (comma-separated) that can review "not helpful" answers on the Metrics page.
ADMIN_EMAILS=
# Optional: append every 👍/👎 (with name, company, email) to a Google Sheet. See docs/GOOGLE_SHEETS.md.
FEEDBACK_SHEET_URL=
FEEDBACK_SHEET_TOKEN=

# ---- Metrics and export ----------------------------------------------------------------------
# Extra or changed model prices for cost metrics, USD per 1M tokens: {"model": [input, output]}
LLM_PRICES=
EXPORT_MAX_ROWS=10000
